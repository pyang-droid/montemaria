rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function activeUser() {
      return signedIn()
        && exists(userPath(request.auth.uid))
        && get(userPath(request.auth.uid)).data.get('status', 'Active') == 'Active';
    }

    function hasRole(roles) {
      return activeUser()
        && get(userPath(request.auth.uid)).data.role in roles;
    }

    function isAdmin() {
      return hasRole(['admin', 'tourism']);
    }

    function isStaff() {
      return hasRole(['staff', 'admin', 'tourism']);
    }

    function assignedTo(attractionId) {
      let assignment = /databases/$(database)/documents/staffAssignments/$(request.auth.uid);
      return isStaff()
        && (isAdmin()
          || (exists(assignment)
            && get(assignment).data.active == true
            && get(assignment).data.attractionId == attractionId));
    }

    function validOccupancyTransition(
      eventType,
      previousVisitStatus,
      nextVisitStatus,
      previousCount,
      nextCount,
      pax
    ) {
      return (eventType == 'ENTRY'
          && previousVisitStatus == 'outside'
          && nextVisitStatus == 'inside'
          && nextCount == previousCount + pax)
        || (eventType == 'EXIT'
          && previousVisitStatus == 'inside'
          && nextVisitStatus == 'exited'
          && nextCount == previousCount - pax);
    }

    function validStaffAttractionOccupancyUpdate(attractionId) {
      let eventId = request.resource.data.get('lastOccupancyLogId', '');
      let bookingId = request.resource.data.get('lastOccupancyBookingId', '');
      let eventPath = /databases/$(database)/documents/visitorLogs/$(eventId);
      let bookingPath = /databases/$(database)/documents/bookings/$(bookingId);
      return assignedTo(attractionId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'currentVisitors', 'updatedAt', 'lastOccupancyLogId',
          'lastOccupancyBookingId'
        ])
        && request.resource.data.diff(resource.data).affectedKeys().hasAll([
          'currentVisitors', 'updatedAt', 'lastOccupancyLogId'
        ])
        && eventId is string
        && eventId != resource.data.get('lastOccupancyLogId', '')
        && bookingId is string
        && exists(bookingPath)
        && existsAfter(eventPath)
        && existsAfter(bookingPath)
        && validStaffAttractionOccupancyEvent(
          attractionId, bookingId, eventId, eventPath, bookingPath
        );
    }

    function validStaffAttractionOccupancyEvent(
      attractionId,
      bookingId,
      eventId,
      eventPath,
      bookingPath
    ) {
      let event = getAfter(eventPath).data;
      let bookingBefore = get(bookingPath).data;
      let bookingAfter = getAfter(bookingPath).data;
      return event.bookingId == bookingId
        && event.attractionId == attractionId
        && event.eventType in ['ENTRY', 'EXIT']
        && event.pax is int
        && event.pax > 0
        && event.createdAt == request.time
        && bookingBefore.attractionId == attractionId
        && bookingBefore.status == 'confirmed'
        && bookingBefore.paymentStatus in ['paid', 'free']
        && bookingBefore.ticketStatus == 'active'
        && bookingBefore.numberOfVisitors == event.pax
        && bookingAfter.attractionId == attractionId
        && bookingAfter.diff(bookingBefore).affectedKeys().hasOnly([
          'visitStatus', 'updatedAt', 'lastOccupancyEventId'
        ])
        && bookingAfter.diff(bookingBefore).affectedKeys().hasAll([
          'visitStatus', 'updatedAt', 'lastOccupancyEventId'
        ])
        && bookingAfter.lastOccupancyEventId == eventId
        && bookingAfter.updatedAt == request.time
        && resource.data.currentVisitors is int
        && resource.data.capacity is int
        && request.resource.data.currentVisitors is int
        && request.resource.data.currentVisitors >= 0
        && request.resource.data.currentVisitors <= resource.data.capacity
        && request.resource.data.updatedAt == request.time
        && request.resource.data.lastOccupancyLogId == eventId
        && request.resource.data.lastOccupancyBookingId == bookingId
        && (event.eventType != 'ENTRY'
          || (resource.data.get('queuePaused', false) != true
            && resource.data.status != 'Closed'))
        && validOccupancyTransition(
          event.eventType,
          bookingBefore.get('visitStatus', 'outside'),
          bookingAfter.visitStatus,
          resource.data.currentVisitors,
          request.resource.data.currentVisitors,
          event.pax
        );
    }

    function validStaffBookingOccupancyUpdate(bookingId) {
      let attractionId = resource.data.attractionId;
      let eventId = request.resource.data.get('lastOccupancyEventId', '');
      let eventPath = /databases/$(database)/documents/visitorLogs/$(eventId);
      let attractionPath = /databases/$(database)/documents/attractions/$(attractionId);
      return assignedTo(attractionId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'visitStatus', 'updatedAt', 'lastOccupancyEventId'
        ])
        && request.resource.data.diff(resource.data).affectedKeys().hasAll([
          'visitStatus', 'updatedAt', 'lastOccupancyEventId'
        ])
        && eventId is string
        && eventId != resource.data.get('lastOccupancyEventId', '')
        && existsAfter(eventPath)
        && exists(attractionPath)
        && existsAfter(attractionPath)
        && validStaffBookingOccupancyEvent(
          bookingId, attractionId, eventId, eventPath, attractionPath
        );
    }

    function validStaffBookingOccupancyEvent(
      bookingId,
      attractionId,
      eventId,
      eventPath,
      attractionPath
    ) {
      let event = getAfter(eventPath).data;
      let attractionBefore = get(attractionPath).data;
      let attractionAfter = getAfter(attractionPath).data;
      return event.bookingId == bookingId
        && event.attractionId == attractionId
        && event.eventType in ['ENTRY', 'EXIT']
        && event.pax is int
        && event.pax == resource.data.numberOfVisitors
        && event.createdAt == request.time
        && resource.data.status == 'confirmed'
        && resource.data.paymentStatus in ['paid', 'free']
        && resource.data.ticketStatus == 'active'
        && request.resource.data.lastOccupancyEventId == eventId
        && request.resource.data.updatedAt == request.time
        && request.resource.data.visitStatus
          == (event.eventType == 'ENTRY' ? 'inside' : 'exited')
        && attractionAfter.diff(attractionBefore).affectedKeys().hasOnly([
          'currentVisitors', 'updatedAt', 'lastOccupancyLogId',
          'lastOccupancyBookingId'
        ])
        && attractionAfter.diff(attractionBefore).affectedKeys().hasAll([
          'currentVisitors', 'updatedAt', 'lastOccupancyLogId'
        ])
        && attractionAfter.lastOccupancyLogId == eventId
        && attractionAfter.lastOccupancyBookingId == bookingId
        && attractionAfter.updatedAt == request.time
        && (event.eventType != 'ENTRY'
          || (attractionBefore.get('queuePaused', false) != true
            && attractionBefore.status != 'Closed'))
        && validOccupancyTransition(
          event.eventType,
          resource.data.get('visitStatus', 'outside'),
          request.resource.data.visitStatus,
          attractionBefore.currentVisitors,
          attractionAfter.currentVisitors,
          event.pax
        );
    }

    function validStaffVisitorLog(logId) {
      let bookingId = request.resource.data.get('bookingId', '');
      let attractionId = request.resource.data.attractionId;
      let bookingPath = /databases/$(database)/documents/bookings/$(bookingId);
      let attractionPath = /databases/$(database)/documents/attractions/$(attractionId);
      return bookingId is string
        && request.resource.data.eventType in ['ENTRY', 'EXIT']
        && exists(bookingPath)
        && existsAfter(bookingPath)
        && exists(attractionPath)
        && existsAfter(attractionPath)
        && validStaffVisitorLogEvent(
          logId, bookingId, attractionId, bookingPath, attractionPath
        );
    }

    function validStaffVisitorLogEvent(
      logId,
      bookingId,
      attractionId,
      bookingPath,
      attractionPath
    ) {
      let bookingBefore = get(bookingPath).data;
      let bookingAfter = getAfter(bookingPath).data;
      let attractionBefore = get(attractionPath).data;
      let attractionAfter = getAfter(attractionPath).data;
      return request.resource.data.bookingId == bookingId
        && request.resource.data.attractionId == attractionId
        && request.resource.data.pax is int
        && request.resource.data.pax > 0
        && request.resource.data.createdAt == request.time
        && bookingBefore.attractionId == attractionId
        && bookingBefore.status == 'confirmed'
        && bookingBefore.paymentStatus in ['paid', 'free']
        && bookingBefore.ticketStatus == 'active'
        && bookingBefore.numberOfVisitors == request.resource.data.pax
        && bookingAfter.diff(bookingBefore).affectedKeys().hasOnly([
          'visitStatus', 'updatedAt', 'lastOccupancyEventId'
        ])
        && bookingAfter.lastOccupancyEventId == logId
        && bookingAfter.updatedAt == request.time
        && attractionAfter.diff(attractionBefore).affectedKeys().hasOnly([
          'currentVisitors', 'updatedAt', 'lastOccupancyLogId',
          'lastOccupancyBookingId'
        ])
        && attractionAfter.lastOccupancyLogId == logId
        && attractionAfter.lastOccupancyBookingId == bookingId
        && attractionAfter.updatedAt == request.time
        && (request.resource.data.eventType != 'ENTRY'
          || (attractionBefore.get('queuePaused', false) != true
            && attractionBefore.status != 'Closed'))
        && validOccupancyTransition(
          request.resource.data.eventType,
          bookingBefore.get('visitStatus', 'outside'),
          bookingAfter.visitStatus,
          attractionBefore.currentVisitors,
          attractionAfter.currentVisitors,
          request.resource.data.pax
        );
    }

    function validQrReference(data) {
      return data.paymentMethod in ['gcash', 'maya']
        && data.transactionReference is string
        && data.transactionReference.matches('^[A-Z0-9]{6,40}$');
    }

    function verifiedQrPayment(paymentId) {
      let payment = request.resource.data;
      let bookingPath = /databases/$(database)/documents/bookings/$(payment.bookingId);
      let before = get(bookingPath).data;
      let after = getAfter(bookingPath).data;
      return payment.keys().hasOnly([
          'bookingId', 'userId', 'amount', 'status', 'paymentMethod',
          'transactionReference', 'verifiedBy', 'createdAt'
        ])
        && validQrReference(payment)
        && paymentId == payment.paymentMethod + '-' + payment.transactionReference
        && payment.status == 'paid'
        && payment.verifiedBy == request.auth.uid
        && payment.createdAt == request.time
        && before.status == 'pending'
        && before.paymentStatus == 'pending'
        && payment.userId == before.userId
        && payment.amount == before.amount
        && payment.paymentMethod == before.paymentMethod
        && payment.transactionReference == before.transactionReference
        && after.status == 'confirmed'
        && after.paymentStatus == 'paid'
        && after.ticketStatus == 'active'
        && after.ticketCode is string
        && after.ticketCode.matches('^[A-F0-9-]{36}$')
        && after.diff(before).affectedKeys().hasOnly([
          'status', 'paymentStatus', 'ticketCode', 'ticketStatus', 'updatedAt'
        ]);
    }

    function validFreeBooking(booking) {
      let attraction = get(
        /databases/$(database)/documents/attractions/$(booking.attractionId)
      ).data;
      return booking.keys().hasOnly([
          'userId', 'visitor', 'email', 'attractionId', 'attractionName',
          'bookingDate', 'bookingTime', 'numberOfVisitors', 'amount',
          'status', 'paymentStatus', 'ticketCode', 'ticketStatus',
          'visitStatus', 'createdAt'
        ])
        && booking.keys().hasAll([
          'userId', 'visitor', 'email', 'attractionId', 'attractionName',
          'bookingDate', 'bookingTime', 'numberOfVisitors', 'amount',
          'status', 'paymentStatus', 'ticketCode', 'ticketStatus',
          'visitStatus', 'createdAt'
        ])
        && booking.userId == request.auth.uid
        && booking.visitor is string
        && booking.email == request.auth.token.email
        && booking.attractionName == attraction.name
        && booking.bookingDate is string
        && booking.bookingDate.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && booking.bookingTime is string
        && booking.bookingTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
        && booking.numberOfVisitors is int
        && booking.numberOfVisitors > 0
        && attraction.capacity is int
        && attraction.capacity > 0
        && booking.numberOfVisitors <= attraction.capacity
        && booking.amount == 0
        && booking.status == 'confirmed'
        && booking.paymentStatus == 'free'
        && booking.ticketCode is string
        && booking.ticketCode.matches('^[A-F0-9-]{36}$')
        && booking.ticketStatus == 'active'
        && booking.visitStatus == 'outside'
        && booking.createdAt == request.time
        && attraction.type == 'Free'
        && attraction.status == 'Open'
        && attraction.isActive == true
        && attraction.isPublished == true;
    }

    match /users/{userId} {
      allow read: if activeUser() && (request.auth.uid == userId || isAdmin());
      allow create: if (
          signedIn()
          && request.auth.uid == userId
          && request.resource.data.keys().hasOnly([
            'email', 'createdAt', 'role', 'status', 'firstName', 'lastName',
            'username', 'mobileNumber', 'photoURL'
          ])
          && request.resource.data.keys().hasAll(['email', 'createdAt', 'role'])
          && request.resource.data.email == request.auth.token.email
          && request.resource.data.role == 'visitor'
          && request.resource.data.get('status', 'Active') == 'Active'
        ) || (
          isAdmin()
          && request.resource.data.keys().hasOnly([
            'email', 'createdAt', 'role', 'status', 'firstName', 'lastName'
          ])
          && request.resource.data.keys().hasAll([
            'email', 'createdAt', 'role', 'status', 'firstName', 'lastName'
          ])
          && request.resource.data.email is string
          && request.resource.data.createdAt is string
          && request.resource.data.role == 'staff'
          && request.resource.data.status == 'Active'
          && request.resource.data.firstName is string
          && request.resource.data.firstName.size() > 0
          && request.resource.data.lastName is string
          && request.resource.data.lastName.size() > 0
        );
      allow update: if isAdmin()
        || (activeUser()
          && request.auth.uid == userId
          && request.resource.data.role == resource.data.role
          && request.resource.data.get('status', 'Active') == resource.data.get('status', 'Active')
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'firstName', 'lastName', 'username', 'mobileNumber', 'photoURL',
            'updatedAt'
          ]));
      allow delete: if isAdmin();
    }

    match /attractions/{attractionId} {
      allow read: if isAdmin()
        || (isStaff() && assignedTo(attractionId))
        || (!isStaff()
          && resource.data.isActive == true
          && resource.data.isPublished == true);
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || validStaffAttractionOccupancyUpdate(attractionId);
    }

    match /attractionAccessRequests/{requestId} {
      allow read: if activeUser()
        && (resource.data.userId == request.auth.uid
          || isAdmin()
          || assignedTo(resource.data.attractionId));
      allow create: if activeUser()
        && request.resource.data.keys().hasOnly([
          'userId', 'userEmail', 'attractionId', 'attractionName',
          'requestType', 'requestedVisitors', 'status', 'createdAt'
        ])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.userEmail == request.auth.token.email
        && request.resource.data.requestType == 'free_access'
        && request.resource.data.status == 'pending'
        && request.resource.data.requestedVisitors is int
        && request.resource.data.requestedVisitors > 0
        && request.resource.data.createdAt == request.time
        && get(/databases/$(database)/documents/attractions/$(request.resource.data.attractionId)).data.type == 'Free'
        && request.resource.data.attractionName
          == get(/databases/$(database)/documents/attractions/$(request.resource.data.attractionId)).data.name
        && get(/databases/$(database)/documents/attractions/$(request.resource.data.attractionId)).data.status == 'Open'
        && get(/databases/$(database)/documents/attractions/$(request.resource.data.attractionId)).data.isActive == true
        && get(/databases/$(database)/documents/attractions/$(request.resource.data.attractionId)).data.isPublished == true
        && request.resource.data.requestedVisitors
          <= get(/databases/$(database)/documents/attractions/$(request.resource.data.attractionId)).data.capacity;
      allow update: if isAdmin()
        && resource.data.status == 'pending'
        && request.resource.data.status in ['approved', 'denied']
        && request.resource.data.reviewedBy == request.auth.uid
        && request.resource.data.reviewedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'reviewedBy', 'reviewedAt']);
      allow delete: if false;
    }

    match /bookings/{bookingId} {
      allow read: if activeUser()
        && (resource.data.userId == request.auth.uid
          || isAdmin()
          || assignedTo(resource.data.attractionId));
      allow create: if activeUser()
        && (
          (
            request.resource.data.userId == request.auth.uid
            && request.resource.data.status == 'pending'
            && request.resource.data.paymentStatus == 'pending'
            && (!request.resource.data.keys().hasAny(['paymentMethod', 'transactionReference'])
              || (request.resource.data.numberOfVisitors == 1
                && validQrReference(request.resource.data)))
            && !request.resource.data.keys().hasAny(['ticketCode', 'ticketStatus'])
            && request.resource.data.numberOfVisitors is int
            && request.resource.data.numberOfVisitors > 0
            && request.resource.data.keys().hasOnly([
              'userId', 'visitor', 'email', 'attractionId', 'attractionName',
              'bookingDate', 'bookingTime', 'numberOfVisitors', 'amount',
              'status', 'paymentStatus', 'paymentMethod',
              'transactionReference', 'createdAt'
            ])
            && get(/databases/$(database)/documents/attractions/$(request.resource.data.attractionId)).data.type == 'Paid'
            && get(/databases/$(database)/documents/attractions/$(request.resource.data.attractionId)).data.status == 'Open'
            && get(/databases/$(database)/documents/attractions/$(request.resource.data.attractionId)).data.isActive == true
            && get(/databases/$(database)/documents/attractions/$(request.resource.data.attractionId)).data.isPublished == true
            && request.resource.data.amount
              == get(/databases/$(database)/documents/attractions/$(request.resource.data.attractionId)).data.entranceFee
                * request.resource.data.numberOfVisitors
          )
          || validFreeBooking(request.resource.data)
        );
      allow update: if isAdmin()
        || (activeUser()
          && request.auth.uid == resource.data.userId
          && resource.data.status == 'pending'
          && resource.data.paymentStatus == 'pending'
          && request.resource.data.status == 'cancelled'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']))
        || validStaffBookingOccupancyUpdate(bookingId);
      allow delete: if isAdmin();
    }

    match /payments/{paymentId} {
      allow read: if activeUser()
        && (isAdmin() || resource.data.userId == request.auth.uid);
      allow create: if isAdmin() && verifiedQrPayment(paymentId);
      allow update, delete: if false;
    }

    match /visitorLogs/{logId} {
      allow read: if activeUser()
        && (isAdmin() || assignedTo(resource.data.attractionId));
      allow create: if assignedTo(request.resource.data.attractionId)
        && request.resource.data.keys().hasOnly([
          'bookingId', 'ticketId', 'visitorName', 'attractionId',
          'attractionName', 'eventType', 'pax', 'verifiedBy',
          'reason', 'createdAt'
        ])
        && request.resource.data.eventType in ['ENTRY', 'EXIT', 'DENIED']
        && request.resource.data.pax is int
        && request.resource.data.pax > 0
        && (isAdmin()
          || request.resource.data.eventType == 'DENIED'
          || validStaffVisitorLog(logId));
      allow update, delete: if isAdmin();
    }

    match /staffAssignments/{userId} {
      allow read: if activeUser()
        && (request.auth.uid == userId || isAdmin());
      allow create, update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
